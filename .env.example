# Supabase — browser + server (safe to expose, required on client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary — browser (safe to expose)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Obvious External API — server-only (NO NEXT_PUBLIC_ prefix — never expose to the browser)
# Used by POST /api/tasks to proxy instructions to:
#   POST https://api.app.obvious.ai/api/v1/projects/{OBVIOUS_PROJECT_ID}/thread
#
# OBVIOUS_API_KEY  — generate in Obvious: Settings → Workspace → Integrations → External Access
# OBVIOUS_PROJECT_ID — the target project's ID from its Obvious workspace URL
#
# Set both in the Vercel dashboard for Production + Preview.
# For local dev, add them to .env.local (never commit .env.local).
OBVIOUS_API_KEY=
OBVIOUS_PROJECT_ID=


# Affiliate tracking — server-only (NO NEXT_PUBLIC_ prefix — links are always
# built server-side in lib/affiliates.ts, never in the browser)
#
# "Where to buy" links work with zero config (plain, non-affiliate outbound
# search links). Set these once Paul is approved for each program to start
# earning commission — no code changes required.
#
# AFFILIATE_FRAGRANCEX_ID  — Rakuten Advertising publisher/affiliate ID
# AFFILIATE_FRAGRANCEX_MID — Rakuten Advertising merchant ID for FragranceX
#                            (shown on FragranceX's advertiser profile page
#                            inside the Rakuten dashboard once approved)
# AFFILIATE_AMAZON_TAG     — Amazon Associates tracking tag (e.g. "topnote-20")
#
# Set all three in the Vercel dashboard for Production + Preview.
# For local dev, add them to .env.local (never commit .env.local).
AFFILIATE_FRAGRANCEX_ID=
AFFILIATE_FRAGRANCEX_MID=
AFFILIATE_AMAZON_TAG=
